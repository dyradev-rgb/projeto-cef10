# =====================================================================
# .streamlit/secrets.toml.example - MODELO DE REFERENCIA PARA AUDITORIA
# Este arquivo e apenas a estrutura esperada. NAO coloque valores reais.
# Para criar o arquivo de trabalho (nao versionado), execute:
#   python scripts/gerar_credenciais.py
#
# Estrutura:
#   [geral]            - chave do bloco genesis
#   [users.<id>]       - um bloco por gestor (id = identificador de login)
#     nome             - nome de exibicao
#     hash_senha       - hash PBKDF2 (formato padrao, ver config/seguranca.py)
#     role             - admin | gestor
#     chave            - chave HMAC de 256 bits do gestor
# =====================================================================

[geral]
chave_genesis = "TROQUE_POR_CHAVE_ALEATORIA_GENESIS"

[users.diretor]
nome = "Carlos Alberto (Diretor)"
hash_senha = "pbkdf2_sha256$600000$SALHEX$HASHHEX"
role = "gestor"
chave = "TROQUE_POR_CHAVE_ALEATORIA_DIRETOR"

[users.secretaria]
nome = "Mariana Souza (Chefe de Secretaria)"
hash_senha = "pbkdf2_sha256$600000$SALHEX$HASHHEX"
role = "gestor"
chave = "TROQUE_POR_CHAVE_ALEATORIA_SECRETARIA"

[users.admin]
nome = "Administrador do Sistema (Root)"
hash_senha = "pbkdf2_sha256$600000$SALHEX$HASHHEX"
role = "admin"
chave = "TROQUE_POR_CHAVE_ALEATORIA_ADMIN"