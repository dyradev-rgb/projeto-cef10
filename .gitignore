# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Segredos - NUNCA versionar credenciais geradas
.streamlit/secrets.toml

# IDE / SO
.vscode/
.idea/
.DS_Store

# Artefatos de execucao
*.log